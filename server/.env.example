# 本地开发用（SQLite）。生产请用仓库根目录的 .env.example + docker compose
WB_ENV=dev
WB_DATABASE_URL=sqlite:///./data/workbench.db
WB_STORAGE_DIR=./data/storage
WB_ADMIN_USERNAME=admin
WB_ADMIN_PASSWORD=admin12345
WB_PUBLIC_BASE_URL=http://127.0.0.1:18080
WB_COOKIE_SECURE=false
# 本地开发可以先生成一个自己的 key；换 key 会让已保存的翻译凭据失效
# python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
WB_ENCRYPTION_KEY=

# Per API process: pool capacity 15; admission reserves 2 connections.
WB_DB_POOL_SIZE=5
WB_DB_MAX_OVERFLOW=10
WB_DB_POOL_TIMEOUT=5
WB_REQUEST_QUEUE_TIMEOUT=10
