# 复制为 .env 并修改；不要把真实密码与密钥提交到仓库
# 公开端口
WB_HTTP_PORT=18743
WB_PUBLIC_BASE_URL=http://127.0.0.1:18743

# 反代信任边界：web 容器在 proxy 网络上的固定地址，API 只接受该地址发来的 X-Forwarded-*
# 改这两个值时要一起改，且 WB_NGINX_IP 必须落在 WB_PROXY_SUBNET 内
WB_NGINX_IP=172.28.0.10
WB_PROXY_SUBNET=172.28.0.0/16

# 数据库（compose 内的服务名是 db）
WB_DB_NAME=workbench
WB_DB_USER=workbench
WB_DB_PASSWORD=请改成随机强密码
WB_DB_PORT=5433

# 唯一管理员账号：首次启动创建，之后以数据库为准
WB_ADMIN_USERNAME=admin
WB_ADMIN_PASSWORD=请改成至少 12 位的强密码

# 翻译凭据加密主密钥（必须先生成并长期保存）
# 生成：python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
WB_ENCRYPTION_KEY=

# HTTPS 部署时改为 true（Cookie 加 Secure）
WB_COOKIE_SECURE=false

# 单文件上限（字节）
WB_MAX_UPLOAD_BYTES=20000000

# 登录失败记录保留天数（维护任务清理）
WB_LOGIN_ATTEMPT_RETENTION_DAYS=7
WB_WHITEBOARD_ASSET_GRACE_HOURS=24

# Per API process: pool capacity 15; admission reserves 2 connections.
WB_DB_POOL_SIZE=5
WB_DB_MAX_OVERFLOW=10
WB_DB_POOL_TIMEOUT=5
WB_REQUEST_QUEUE_TIMEOUT=10

# 信息聚合：公开热榜/RSS 出站。正式部署请使用经核验、允许调用的 DailyHotApi 兼容实例。
WB_FEED_ENABLED=true
WB_FEED_DAILYHOT_BASE_URL=https://api-hot.imsyy.top
WB_FEED_GOOGLE_TRENDS_URL=https://trends.google.com/trending/rss?geo=US
WB_FEED_HOT_INTERVAL_SECONDS=900
WB_FEED_RSS_INTERVAL_SECONDS=1800
WB_FEED_SCHEDULER_INTERVAL_SECONDS=60
WB_FEED_TIMEOUT_SECONDS=12
WB_FEED_MAX_BYTES=2000000
WB_FEED_MAX_REDIRECTS=5
WB_FEED_RETRY_MAX_SECONDS=3600
# RunSignup 赛事：全量抓取耗时数分钟，在后台线程执行并使用独立冷却（默认 10 分钟）。
WB_FEED_RUNSIGNUP_INTERVAL_SECONDS=21600
WB_FEED_RUNSIGNUP_COOLDOWN_SECONDS=600
WB_FEED_RUNSIGNUP_WINDOW_DAYS=90

# 视频解析：内嵌 media-parser。默认启用抖音/小红书/快手。
# Cookie 不是必填；遇到平台登录/安全校验时再补充。Cookie 会过期，失效后重新复制。
WB_MEDIA_ENABLED=true
WB_MEDIA_PLATFORMS=douyin,xhs,kuaishou
WB_MEDIA_TIMEOUT_SECONDS=60
WB_MEDIA_MAX_CONCURRENCY=2
WB_MEDIA_MAX_DOWNLOAD_BYTES=300000000
WB_MEDIA_DOWNLOAD_TTL_SECONDS=7200
WB_MEDIA_DOUYIN_COOKIE=
WB_MEDIA_XHS_COOKIE=
WB_MEDIA_KUAISHOU_COOKIE=
